# =========================================================================
# EZ TRIP - ENVIRONMENT VARIABLES EXAMPLE
# =========================================================================

# Database Connection (Neon Serverless PostgreSQL)
# DATABASE_URL: Connection pooled URL (berakhiran -pooler.neon.tech)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct connection URL untuk migrasi schema (tanpa pooler)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Midtrans Payment Gateway (Sandbox / Production)
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com"

# Next.js App URL (misal: http://localhost:3000 atau domain Vercel Anda)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
